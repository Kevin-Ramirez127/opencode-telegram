# Copy this file to .env and put your real values there. Never commit .env.
# The token can also be supplied directly via the environment (preferred for
# systemd: EnvironmentFile=.../opencode-telegram.env, or a container secret).

# Required: bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: OpenCode HTTP API. When omitted, the daemon discovers the local
# background service registration automatically (~/.local/state/opencode/
# service.json). Set these for remote or explicitly managed servers.
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_PASSWORD=

# Optional: loopback address for the OpenCode plugin's settings API.
# LISTEN_ADDR=127.0.0.1:8787

# Optional: require a bearer token from the plugin.
# PLUGIN_TOKEN=

# Optional overrides
# DATA_DIR=./data                 # where allowlist.json / settings.json live
# RELOAD_SECONDS=5s               # how often config files are rechecked
# HTTP_TIMEOUT_SECONDS=20s        # bound for each OpenCode API request
